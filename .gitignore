.loop-cockpit/
~/.loop-cockpit/
.loop-cockpit-logs/
*.tsbuildinfo

# Spike experimental output（spike 自己的临时输出别 commit）
spike/**/tmp/
spike/**/.local/

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# PTY native bindings (may lose exec permission)
node_modules/node-pty/prebuilds/*/spawn-helper
