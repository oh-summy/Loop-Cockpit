# Host
HOST_PORT=3000
HOST_BIND=127.0.0.1
# DATA_DIR 支持 ~ 前缀展开;不设置则使用 $HOME/.loop-cockpit
DATA_DIR=~/.loop-cockpit
LOG_LEVEL=info

# DEV: 设为 1 时 runner 使用 mock-claude (node -e) 代替真实 claude CLI，避免 API 计费
MOCK_CLAUDE=1

# 自定义允许调用的 CORS 源 (comma-separated, 默认 localhost:5173)
# LOOP_CORS_ORIGINS=https://your-host.example.com

# 进程退出 grace (SIGTERM -> SIGKILL 间隔); 默认 4000 ms
SIGKILL_GRACE_MS=4000

# 通知渠道密码引用 (推荐): 让前端填 env:XYZ，运行时从环境变量读
SMTP_PASS=
TELEGRAM_BOT_TOKEN=
LARK_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
