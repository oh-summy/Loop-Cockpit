    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "nanoid": "^5.0.0",
    "node-cron": "^3.0.0",
    "node-pty": "^1.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "stream-json": "^1.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/stream-json": "^1.7.0",
    "drizzle-kit": "^0.30.0",
